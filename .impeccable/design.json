  "components": [
    {
      "name": "Board Row",
      "kind": "custom",
      "refersTo": "board-row",
      "description": "The signature row: time, tool and body on fixed columns, ruled by a hairline.",
      "html": "<button class=\"ds-row\"><span class=\"ds-time\"><span class=\"ds-lamp\"></span>Now</span><span class=\"ds-tool\">Claude</span><span class=\"ds-body\"><span class=\"ds-title\">Session title</span><span class=\"ds-meta\">project 24 prompts</span></span></button>",
      "css": ".ds-row{display:grid;grid-template-columns:72px 48px minmax(0,1fr);gap:0 6px;align-items:baseline;width:384px;padding:9px 14px;background:transparent;border:none;border-bottom:1px solid var(--border);text-align:left;color:var(--text-secondary);cursor:pointer}.ds-row:hover{background:var(--bg-hover)}.ds-row:focus-visible{outline:2px solid var(--accent);outline-offset:-2px}.ds-time{display:flex;align-items:center;gap:5px;font-size:12px;font-variant-numeric:tabular-nums;color:var(--accent-text)}.ds-lamp{width:6px;height:6px;border-radius:50%;background:var(--accent)}.ds-tool{font-size:12px;font-weight:500}.ds-body{display:flex;flex-direction:column;gap:2px}.ds-title{font-size:13px;font-weight:500;line-height:1.35;color:var(--text-primary)}.ds-meta{font-size:12px;color:var(--text-muted);font-variant-numeric:tabular-nums}"
    },
    {
      "name": "Rail Row",
      "kind": "nav",
      "refersTo": "rail-row",
      "description": "Project and view navigation in the rail, with a tabular count.",
      "html": "<button class=\"ds-rail\">Project name<span class=\"ds-count\">12</span></button>",
      "css": ".ds-rail{display:flex;align-items:center;justify-content:space-between;gap:6px;width:204px;padding:6px 8px;background:transparent;border:none;border-radius:5px;font-size:13px;color:var(--text-secondary);cursor:pointer}.ds-rail:hover{background:var(--bg-hover)}.ds-rail:focus-visible{outline:2px solid var(--accent);outline-offset:1px}.ds-count{font-size:12px;font-variant-numeric:tabular-nums;color:var(--text-muted)}"
    },
    {
      "name": "Search Field",
      "kind": "input",
      "refersTo": "input-search",
      "description": "Raised field whose border turns amber on focus.",
      "html": "<input class=\"ds-input\" placeholder=\"Search everything\" />",
      "css": ".ds-input{width:212px;padding:7px 9px;background:var(--bg-elevated);border:1px solid var(--border);border-radius:6px;outline:none;font-size:13px;color:var(--text-primary)}.ds-input::placeholder{color:var(--text-muted)}.ds-input:focus{border-color:var(--accent)}"
    },
    {
      "name": "Segmented Control",
      "kind": "chip",
      "refersTo": "segment",
      "description": "Tool and scope filters; the active thumb is neutral, never amber.",
      "html": "<div class=\"ds-seg\"><button class=\"ds-seg-item ds-seg-on\">All</button><button class=\"ds-seg-item\">Claude</button><button class=\"ds-seg-item\">Codex</button></div>",
      "css": ".ds-seg{display:flex;gap:2px;width:212px;padding:2px;background:var(--bg-elevated);border-radius:6px}.ds-seg-item{flex:1;padding:4px 6px;background:transparent;border:none;border-radius:4px;font-size:12px;color:var(--text-muted);cursor:pointer}.ds-seg-item:hover{color:var(--text-primary)}.ds-seg-item:focus-visible{outline:2px solid var(--accent);outline-offset:1px}.ds-seg-on{background:var(--bg-selected);color:var(--text-primary);font-weight:500}"
    },
    {
      "name": "Header Button",
      "kind": "button",
      "refersTo": "button-header",
      "description": "The standard quiet action in the session header.",
      "html": "<button class=\"ds-btn\">Export</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;gap:6px;min-height:26px;padding:4px 10px;background:transparent;border:1px solid var(--border-strong);border-radius:5px;font-size:12px;color:var(--text-secondary);cursor:pointer}.ds-btn:hover{background:var(--bg-hover);color:var(--text-primary)}.ds-btn:focus-visible{outline:2px solid var(--accent);outline-offset:1px}"
    },
    {
      "name": "Saved Button",
      "kind": "button",
      "refersTo": "button-saved",
      "description": "The saved state, one of amber's three meanings.",
      "html": "<button class=\"ds-saved\">Saved</button>",
      "css": ".ds-saved{min-height:26px;padding:4px 10px;background:var(--accent-soft);border:1px solid var(--accent);border-radius:5px;font-size:12px;color:var(--accent-text);cursor:pointer}.ds-saved:focus-visible{outline:2px solid var(--accent);outline-offset:1px}"
    },
    {
      "name": "Session Tabs",
      "kind": "nav",
      "description": "Session views; the active tab has a 2px amber underline.",
      "html": "<div class=\"ds-tabs\"><button class=\"ds-tab ds-tab-on\">Conversation</button><button class=\"ds-tab\">Changes</button><button class=\"ds-tab\">Agents</button><button class=\"ds-tab\">Stats</button></div>",
      "css": ".ds-tabs{display:flex;gap:14px;border-bottom:1px solid var(--border)}.ds-tab{padding:7px 0;margin-bottom:-1px;background:none;border:none;border-bottom:2px solid transparent;font-size:13px;color:var(--text-muted);cursor:pointer}.ds-tab:hover{color:var(--text-primary)}.ds-tab:focus-visible{outline:2px solid var(--accent);outline-offset:1px}.ds-tab-on{border-bottom-color:var(--accent);color:var(--text-primary);font-weight:500}"
