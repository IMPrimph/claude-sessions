---
import Base from '../layouts/Base.astro'
---
<Base title="Page not found | Evertusk" description="This page doesn't exist." path="/404/" structuredData={{ "@context": "https://schema.org", "@type": "WebPage", name: "Page not found" }} noindex>
  <section class="relative z-10 max-w-[720px] mx-auto px-6 py-24">
    <h1 class="font-display font-bold text-4xl text-white tracking-tight mb-4">Page not found</h1>
    <p class="text-lg text-[#a0a0a8]">That page doesn't exist. <a class="text-amber-300 underline underline-offset-4" href="/">Go to the home page</a>.</p>
  </section>
</Base>
