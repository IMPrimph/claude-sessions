---
import Base from '../layouts/Base.astro'
import { AUTHOR, DOWNLOAD_MAC, GITHUB_URL, INSTALLS, OG_IMAGE, SITE, VERSION } from '../site'

const title = "Evertusk: every Claude Code and Codex session, in one place"
const description = "Find past work across every Claude Code and Codex session. Search every message, see what changed, and keep what would expire. Free, local Mac app."

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", name: "Evertusk", url: SITE + "/", description },
    {
      "@type": "SoftwareApplication",
      name: "Evertusk",
      applicationCategory: "DeveloperApplication",
      operatingSystem: "macOS 12 or later",
      url: SITE + "/",
      description: "A free Mac app for finding past work across Claude Code and Codex sessions: searchable, local, and kept after they would expire.",
      image: OG_IMAGE,
      screenshot: `${SITE}/demo-poster.webp`,
      downloadUrl: DOWNLOAD_MAC,
      softwareVersion: VERSION,
      isAccessibleForFree: true,
      license: `${GITHUB_URL}/blob/main/LICENSE.md`,
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      author: AUTHOR,
      sameAs: [GITHUB_URL],
    },
  ],
}

const features = [
  {
    title: "One history across your tools",
    description: "Claude Code and Codex sessions sit in one list, grouped by the folder you worked in. Each row shows its tool's icon, so you can tell them apart at a glance.",
  },
  {
    title: "Search every word",
    description: "Find that fix from last month by what you remember: a title, an error, something you typed. Search looks through every message in every session.",
  },
  {
    title: "The whole session, as it happened",
    description: "Thinking, tool calls and their output, subagents, pasted images, plans, the moment you interrupted, the option you picked when asked. Not a summary.",
  },
  {
    title: "What it did, at a glance",
    description: "Every file a session changed with its edits, every agent it started, and how long it took and how many tokens it used.",
  },
  {
    title: "Keep what would expire",
    description: "Claude Code deletes sessions after 30 days by default. Save one and Evertusk keeps a full copy, with its images. Export any session to Markdown.",
  },
  {
    title: "Stays on your Mac",
    description: "Reads ~/.claude and ~/.codex directly. No account, no server, nothing uploaded. The only thing it asks the internet for is app updates.",
  },
]

// Written out on the page rather than as FAQPage markup: Google removed FAQ rich results in 2026.
const questions = [
  {
    question: "What is Evertusk?",
    answer: "Evertusk is a free Mac app for reading and searching your Claude Code and Codex sessions. It reads the session files those tools already keep on your Mac and shows them in one list, grouped by project folder.",
  },
  {
    question: "Does Claude Code delete old sessions?",
    answer: `Yes. By default Claude Code deletes session transcripts after 30 days, without showing a message. You can change that with the <code>cleanupPeriodDays</code> setting. <a href="/claude-code-session-history/">How the cleanup works</a>.`,
  },
  {
    question: "Where are Claude Code and Codex sessions stored?",
    answer: `Claude Code keeps them in <code>~/.claude/projects</code>, and <a href="/codex-session-history/">Codex keeps them in <code>~/.codex/sessions</code></a>. Evertusk finds both on its own, so there's nothing to configure.`,
  },
  {
    question: "Does Evertusk upload my sessions?",
    answer: `No. There's no account and no server, and your sessions stay on your Mac. The only thing the app asks the internet for is whether there's an update. <a href="/privacy/">What it reads and writes</a>.`,
  },
  {
    question: "Does it work the same for Codex?",
    answer: "Mostly. Browsing, search, changed files, agents and Markdown export work for both. Saving a separate copy is for Claude Code only, since that's where the 30-day cleanup applies. Codex doesn't record cost, and its thinking is often encrypted.",
  },
  {
    question: "Which Macs does it run on, and what does it cost?",
    answer: `It's free, and it runs on macOS 12 or later on Apple Silicon and Intel. The app isn't signed by Apple yet, so the first launch needs the one Terminal command at the top of this page. The <a href="${GITHUB_URL}">source is available</a> under the FSL-1.1-MIT license.`,
  },
]
---

<Base {title} {description} path="/" {structuredData}>
    <!-- Non-dismissable yellow alert at the very top - first thing every visitor sees -->
    <div slot="top" class="relative z-50 bg-amber-400 text-[#1a1100] border-b border-amber-500/60">
      <div class="max-w-[1296px] mx-auto px-6 py-3 flex items-start sm:items-center gap-3 text-sm">
        <svg class="flex-shrink-0 mt-0.5 sm:mt-0" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
          <line x1="12" y1="9" x2="12" y2="13"/>
          <line x1="12" y1="17" x2="12.01" y2="17"/>
        </svg>
        <div class="flex-1 flex flex-col sm:flex-row sm:items-center sm:gap-3">
          <span class="font-bold">macOS first launch:</span>
          <span class="font-medium">run this once in Terminal — required because the app isn't signed:</span>
          <code class="font-mono text-xs sm:text-sm bg-[#1a1100]/15 text-[#1a1100] px-2 py-1 rounded select-all break-all sm:ml-1">xattr -cr /Applications/Evertusk.app</code>
        </div>
      </div>
    </div>

    <!-- Hero -->
    <section class="relative z-10 max-w-[1296px] mx-auto px-6 pt-14 pb-10">
      <h1 class="font-display font-bold text-4xl md:text-6xl text-white leading-[1.08] tracking-tight mb-5 max-w-3xl text-balance animate-fade-in-up">
        Every Claude Code and Codex session, in one place.
      </h1>
      <p class="max-w-2xl text-lg text-[#a0a0a8] leading-relaxed mb-8 animate-fade-in-up-delay">
        Evertusk is a free Mac app that puts your Claude Code and Codex history in one searchable list. Find the fix you made last month, see exactly what a session did, and keep the ones Claude Code would delete after 30 days.
      </p>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-3 animate-fade-in-up-delay-2">
        <a href={DOWNLOAD_MAC} class="inline-flex items-center gap-3 px-6 py-3 rounded-lg bg-amber-500 text-[#1a1100] font-semibold text-sm hover:bg-amber-400 transition-colors">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Download free for Mac
        </a>
        <span class="text-sm text-[#8a8a92]">macOS 12+ &middot; Apple Silicon &amp; Intel &middot; {INSTALLS}+ installs &middot; v{VERSION}</span>
      </div>
      <p class="text-sm text-[#8a8a92] max-w-xl mt-4">
        macOS may say <span class="text-[#c0c0c8]">"app is damaged"</span> on first launch, because the app isn't signed yet. The Terminal command at the top of this page fixes it.
      </p>
    </section>

    <!-- The working app -->
    <section id="try-it" class="relative z-10 max-w-[1296px] mx-auto px-6 pb-16 scroll-mt-6">
      <figure>
        <div class="demo-window relative rounded-xl overflow-hidden border border-[#2a2a2e] shadow-[0_24px_70px_rgba(0,0,0,0.5)]" data-demo="/demo/">
          <img class="block w-full h-auto" src="/demo-poster.webp" width="2400" height="1520" fetchpriority="high" alt="Evertusk showing Claude Code and Codex sessions in one list, with a conversation open" />
        </div>
        <figcaption class="demo-caption text-sm text-[#8a8a92] mt-4">Evertusk with made-up sessions. On a bigger screen, this is the working app to click around in.</figcaption>
      </figure>
      <script is:inline>
        // The screenshot becomes the real app, on made-up sessions, where the app's window fits.
        const demoWindow = document.querySelector("[data-demo]");
        if (demoWindow && window.matchMedia("(min-width: 900px)").matches) {
          const frame = document.createElement("iframe");
          frame.src = demoWindow.dataset.demo;
          frame.title = "A working demo of Evertusk, with made-up sessions";
          frame.allow = "clipboard-write";
          frame.addEventListener("load", () => {
            demoWindow.querySelector("img")?.remove();
            frame.classList.add("is-ready");
            const caption = document.querySelector(".demo-caption");
            caption.textContent = "This is the app, working. Click anything: the sessions are made up, and it runs entirely in your browser. ";
            const fullSize = document.createElement("a");
            fullSize.href = demoWindow.dataset.demo;
            fullSize.textContent = "Open it full size";
            caption.append(fullSize);
          });
          demoWindow.append(frame);
        }
      </script>
    </section>

    <!-- What it does -->
    <section class="relative z-10 max-w-[1296px] mx-auto px-6 py-16">
      <h2 class="font-display font-bold text-3xl md:text-4xl text-white tracking-tight mb-10 max-w-2xl text-balance">
        Your agents did the work. Now you can find it again.
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-14 border-t border-[#232327]">
        {features.map((feature) => (
          <div class="py-6 border-b border-[#232327]">
            <h3 class="font-display font-semibold text-white text-lg mb-1.5">{feature.title}</h3>
            <p class="text-[#a0a0a8] leading-relaxed max-w-prose">{feature.description}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Questions -->
    <section class="faq relative z-10 max-w-[1296px] mx-auto px-6 py-16">
      <h2 class="font-display font-bold text-3xl md:text-4xl text-white tracking-tight mb-10">Common questions</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-14 gap-y-8">
        {questions.map((item) => (
          <div>
            <h3 class="font-display font-semibold text-white text-lg mb-1.5">{item.question}</h3>
            <p class="text-[#a0a0a8] leading-relaxed max-w-prose" set:html={item.answer} />
          </div>
        ))}
      </div>
    </section>

    <!-- Get it -->
    <section class="relative z-10 max-w-[1296px] mx-auto px-6 py-16">
      <h2 class="font-display font-bold text-3xl md:text-4xl text-white tracking-tight mb-4">Nothing to set up</h2>
      <p class="text-lg text-[#a0a0a8] max-w-2xl leading-relaxed mb-8">
        Download it, drag it to Applications, and open it. There's no account and no configuration: your sessions are already there, because it reads the files your tools already keep.
      </p>
      <a href={DOWNLOAD_MAC} class="inline-flex items-center gap-3 px-6 py-3 rounded-lg bg-amber-500 text-[#1a1100] font-semibold text-sm hover:bg-amber-400 transition-colors">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        Download free for Mac
      </a>
    </section>

</Base>
